"use client";

import { useEffect, useMemo, useState, type FormEvent } from "react";

type Opportunity = {
  id: string;
  title?: string;
  organization?: string;
  description?: string;
  posterUrl?: string;
  location?: string;
  eligibility?: string;
  responsibilities?: string;
  type?: string;
  deadline?: string;
  mode?: string;
  funding?: string;
  careerDomain?: string;
  deadlineType?: string;
  benefits?: string;
  applicationLink?: string;
  status?: string;
  createdAt?: string | null;
  postedByType?: string;
};

const blank = {
  title: "",
  organization: "",
  description: "",
  posterUrl: "",
  location: "",
  eligibility: "",
  responsibilities: "",
  type: "Global Opportunities",
  deadline: "",
  mode: "Remote",
  funding: "Free",
  careerDomain: "AI & Technology",
  deadlineType: "Open",
  benefits: "",
  applicationLink: "",
  status: "active",
};

const input =
  "w-full rounded-xl border border-slate-700 bg-slate-900 px-4 py-3 text-sm text-white outline-none focus:border-cyan-400";

export default function Home() {
  const [unlocked, setUnlocked] = useState(false);
  const [passcode, setPasscode] = useState("");
  const [passcodeError, setPasscodeError] = useState("");
  const [items, setItems] = useState<Opportunity[]>([]);
  const [form, setForm] = useState(blank);
  const [editingId, setEditingId] = useState<string | null>(null);
  const [showForm, setShowForm] = useState(false);
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState("all");
  const [message, setMessage] = useState("");
  const [loading, setLoading] = useState(false);

  async function api(path: string, options: RequestInit = {}) {
    const response = await fetch(path, {
      ...options,
      headers: {
        "Content-Type": "application/json",
        ...options.headers,
      },
    });
    const result = await response.json();
    if (!response.ok) throw new Error(result.error || "Request failed");
    return result;
  }

  async function loadItems() {
    setLoading(true);
    try {
      const result = await api("/api/opportunities");
      setItems(result.opportunities || []);
      setMessage("");
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Could not load opportunities.");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    if (unlocked) loadItems();
  }, [unlocked]);

  function unlock(event: FormEvent) {
    event.preventDefault();
    if (passcode === "1234") {
      setPasscodeError("");
      setUnlocked(true);
    } else {
      setPasscodeError("Incorrect password.");
    }
  }

  function updateField(name: keyof typeof blank, value: string) {
    setForm((current) => ({ ...current, [name]: value }));
  }

  function startEdit(item: Opportunity) {
    setForm({
      title: item.title || "",
      organization: item.organization || "",
      description: item.description || "",
      posterUrl: item.posterUrl || "",
      location: item.location || "",
      eligibility: item.eligibility || "",
      responsibilities: item.responsibilities || "",
      type: item.type || "Global Opportunities",
      deadline: item.deadline || "",
      mode: item.mode || "Remote",
      funding: item.funding || "Free",
      careerDomain: item.careerDomain || "AI & Technology",
      deadlineType: item.deadlineType || "Open",
      benefits: item.benefits || "",
      applicationLink: item.applicationLink || "",
      status: item.status || "active",
    });
    setEditingId(item.id);
    setShowForm(true);
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  async function saveOpportunity(event: FormEvent) {
    event.preventDefault();
    setLoading(true);
    setMessage("");
    try {
      if (editingId) {
        await api("/api/opportunities", {
          method: "PATCH",
          body: JSON.stringify({ ...form, id: editingId }),
        });
        setMessage("Opportunity updated successfully.");
      } else {
        await api("/api/opportunities", {
          method: "POST",
          body: JSON.stringify(form),
        });
        setMessage("Opportunity published successfully.");
      }
      setForm(blank);
      setEditingId(null);
      setShowForm(false);
      await loadItems();
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Could not save opportunity.");
    } finally {
      setLoading(false);
    }
  }

  async function deleteOpportunity(id: string) {
    if (!window.confirm("Delete this opportunity permanently?")) return;
    try {
      await api(`/api/opportunities?id=${encodeURIComponent(id)}`, {
        method: "DELETE",
      });
      setMessage("Opportunity deleted.");
      await loadItems();
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Could not delete opportunity.");
    }
  }

  const filtered = useMemo(() => items.filter((item) => {
    const matchesSearch =
      `${item.title || ""} ${item.organization || ""}`
        .toLowerCase().includes(search.toLowerCase());
    const matchesFilter =
      filter === "all" || item.status === filter;
    return matchesSearch && matchesFilter;
  }), [items, search, filter]);

  if (!unlocked) {
    return (
      <main className="flex min-h-screen items-center justify-center bg-[#080d18] px-5 text-white">
        <form onSubmit={unlock} className="w-full max-w-sm rounded-3xl border border-slate-800 bg-[#101827] p-8">
          <p className="mb-3 text-xs font-bold uppercase tracking-[0.3em] text-cyan-400">Gonn'a Global</p>
          <h1 className="text-2xl font-bold">Admin Dashboard</h1>
          <p className="mb-6 mt-2 text-sm text-slate-400">Enter your dashboard password.</p>
          <input
            className={input}
            type="password"
            placeholder="Password"
            value={passcode}
            onChange={(event) => setPasscode(event.target.value)}
            autoFocus
          />
          {passcodeError && <p className="mt-3 text-sm text-red-400">{passcodeError}</p>}
          <button className="mt-5 w-full rounded-xl bg-cyan-400 px-4 py-3 font-bold text-slate-950">
            Open Dashboard
          </button>
        </form>
      </main>
    );
  }

  return (
    <main className="min-h-screen bg-[#080d18] text-white">
      <header className="border-b border-slate-800 bg-[#0d1524]">
        <div className="mx-auto flex max-w-7xl items-center justify-between px-5 py-5">
          <div>
            <p className="text-xs font-bold uppercase tracking-[0.25em] text-cyan-400">Gonn'a Global</p>
            <h1 className="mt-1 text-xl font-bold">Super Admin Dashboard</h1>
          </div>
          <span className="text-sm text-slate-400">Opportunity Management</span>
        </div>
      </header>

      <section className="mx-auto max-w-7xl px-5 py-8">
        <div className="mb-8 flex flex-wrap items-center justify-between gap-4">
          <div>
            <h2 className="text-3xl font-bold">Opportunities</h2>
            <p className="mt-2 text-sm text-slate-400">Manage listings in the Gonn'a Global database.</p>
          </div>
          <button
            onClick={() => {
              setForm(blank);
              setEditingId(null);
              setShowForm(!showForm);
            }}
            className="rounded-xl bg-cyan-400 px-5 py-3 font-bold text-slate-950 hover:bg-cyan-300"
          >
            {showForm ? "Close Form" : "+ Add Opportunity"}
          </button>
        </div>

        <div className="mb-7 grid gap-4 sm:grid-cols-3">
          {[
            ["Total Opportunities", items.length],
            ["Published", items.filter((x) => x.status === "active").length],
            ["Drafts", items.filter((x) => x.status === "draft").length],
          ].map(([label, value]) => (
            <div key={label} className="rounded-2xl border border-slate-800 bg-[#101827] p-5">
              <p className="text-sm text-slate-400">{label}</p>
              <p className="mt-2 text-3xl font-bold">{value}</p>
            </div>
          ))}
        </div>

        {message && (
          <div className="mb-5 rounded-xl border border-slate-700 bg-[#101827] px-4 py-3 text-sm text-cyan-200">
            {message}
          </div>
        )}

        {showForm && (
          <form onSubmit={saveOpportunity} className="mb-8 rounded-2xl border border-slate-800 bg-[#101827] p-6">
            <h3 className="mb-6 text-xl font-bold">{editingId ? "Edit Opportunity" : "Create Opportunity"}</h3>
            <div className="grid gap-4 md:grid-cols-2">
              <Field label="Opportunity Title *">
                <input className={input} required value={form.title} onChange={(e) => updateField("title", e.target.value)} />
              </Field>
              <Field label="Organization *">
                <input className={input} required value={form.organization} onChange={(e) => updateField("organization", e.target.value)} />
              </Field>
              <Field label="Opportunity Type">
                <Select className={input} value={form.type} onChange={(v) => updateField("type", v)} options={["Global Opportunities", "Internships", "Hackathons", "Sports", "Conferences", "Freelancing", "Events", "Competitions"]} />
              </Field>
              <Field label="Work Mode">
                <Select className={input} value={form.mode} onChange={(v) => updateField("mode", v)} options={["Remote", "Hybrid", "Onsite"]} />
              </Field>
              <Field label="Funding">
                <Select className={input} value={form.funding} onChange={(v) => updateField("funding", v)} options={["Fully Funded", "Paid", "Free"]} />
              </Field>
              <Field label="Career Domain">
                <Select className={input} value={form.careerDomain} onChange={(v) => updateField("careerDomain", v)} options={["AI & Technology", "Business & Startups", "Research & Science", "Leadership & Policy", "Media & Content", "Design & Creativity", "Social Impact", "Sports & Fitness", "Finance & Consulting", "Environment & Sustainability"]} />
              </Field>
              <Field label="Location">
                <input className={input} value={form.location} onChange={(e) => updateField("location", e.target.value)} />
              </Field>
              <Field label="Deadline">
                <input className={input} type="date" value={form.deadline} onChange={(e) => updateField("deadline", e.target.value)} />
              </Field>
              <Field label="Deadline Type">
                <Select className={input} value={form.deadlineType} onChange={(v) => updateField("deadlineType", v)} options={["Closing Soon", "This Week", "This Month", "Open"]} />
              </Field>
              <Field label="Application Link">
                <input className={input} type="url" value={form.applicationLink} onChange={(e) => updateField("applicationLink", e.target.value)} />
              </Field>
              <Field label="Poster Image URL">
                <input className={input} type="url" value={form.posterUrl} onChange={(e) => updateField("posterUrl", e.target.value)} />
              </Field>
              <Field label="Status">
                <Select className={input} value={form.status} onChange={(v) => updateField("status", v)} options={["active", "draft"]} />
              </Field>
              <Field label="Eligibility">
                <textarea className={input} rows={3} value={form.eligibility} onChange={(e) => updateField("eligibility", e.target.value)} />
              </Field>
              <Field label="Responsibilities">
                <textarea className={input} rows={3} value={form.responsibilities} onChange={(e) => updateField("responsibilities", e.target.value)} />
              </Field>
              <Field label="Benefits">
                <textarea className={input} rows={3} value={form.benefits} onChange={(e) => updateField("benefits", e.target.value)} />
              </Field>
            </div>
            <Field label="Description *">
              <textarea className={input} required rows={5} value={form.description} onChange={(e) => updateField("description", e.target.value)} />
            </Field>
            <div className="mt-6 flex flex-wrap gap-3">
              <button disabled={loading} className="rounded-xl bg-cyan-400 px-6 py-3 font-bold text-slate-950 disabled:opacity-50">
                {loading ? "Saving..." : editingId ? "Save Changes" : form.status === "draft" ? "Save Draft" : "Publish Opportunity"}
              </button>
              <button type="button" onClick={() => { setShowForm(false); setEditingId(null); setForm(blank); }} className="rounded-xl border border-slate-700 px-6 py-3">
                Cancel
              </button>
            </div>
          </form>
        )}

        <div className="mb-4 flex flex-wrap gap-3">
          <input className={`${input} max-w-md`} placeholder="Search opportunities..." value={search} onChange={(e) => setSearch(e.target.value)} />
          <select className={`${input} max-w-xs`} value={filter} onChange={(e) => setFilter(e.target.value)}>
            <option value="all">All statuses</option>
            <option value="active">Published</option>
            <option value="draft">Drafts</option>
          </select>
          <button onClick={loadItems} className="rounded-xl border border-slate-700 px-4 py-2 text-sm">Refresh</button>
        </div>

        <div className="overflow-hidden rounded-2xl border border-slate-800 bg-[#101827]">
          {loading && <p className="p-5 text-sm text-slate-400">Loading...</p>}
          {!loading && filtered.length === 0 && <p className="p-8 text-center text-slate-400">No opportunities found.</p>}
          {filtered.map((item) => (
            <div key={item.id} className="flex flex-wrap items-center justify-between gap-4 border-b border-slate-800 p-5 last:border-0">
              <div className="min-w-0 flex-1">
                <h3 className="font-semibold">{item.title}</h3>
                <p className="mt-1 text-sm text-slate-400">{item.organization} · {item.type} · {item.mode}</p>
                <div className="mt-2 flex flex-wrap gap-2 text-xs">
                  <span className={`rounded-full px-3 py-1 ${item.status === "active" ? "bg-emerald-900/50 text-emerald-300" : "bg-amber-900/50 text-amber-300"}`}>
                    {item.status === "active" ? "Published" : "Draft"}
                  </span>
                  <span className="rounded-full bg-slate-800 px-3 py-1 text-slate-300">Posted by Admin</span>
                </div>
              </div>
              <div className="flex gap-2">
                <button onClick={() => startEdit(item)} className="rounded-lg border border-slate-700 px-4 py-2 text-sm hover:bg-slate-800">Edit</button>
                <button onClick={() => deleteOpportunity(item.id)} className="rounded-lg border border-red-900 px-4 py-2 text-sm text-red-300 hover:bg-red-950">Delete</button>
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>
  );
}

function Field({ label, children }: { label: string; children: React.ReactNode }) {
  return (
    <label className="mb-4 block">
      <span className="mb-2 block text-sm text-slate-300">{label}</span>
      {children}
    </label>
  );
}

function Select({
  className,
  value,
  onChange,
  options,
}: {
  className: string;
  value: string;
  onChange: (value: string) => void;
  options: string[];
}) {
  return (
    <select className={className} value={value} onChange={(e) => onChange(e.target.value)}>
      {options.map((option) => <option key={option} value={option}>{option}</option>)}
    </select>
  );
}
